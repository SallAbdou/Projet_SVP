+.chat-suggestion{min-height:44px;padding:8px 14px;border-radius:18px;border:1.5px solid var(--bord-fort);background:var(--champ);color:var(--texte);font:inherit;font-size:14px;font-weight:600;line-height:1.3;text-align:left;cursor:pointer}
+.chat-suggestion:hover{border-color:var(--brun)}
+.chat-suggestions .lien{font-size:14px}
+.chat-note{padding:0 16px 12px;background:var(--creme);font-size:12px;color:var(--doux)}
+@media (prefers-reduced-motion:reduce){.faq-chevron{transition:none}}

+  .ticket-ligne{padding:12px 14px}
+  .chat,.chat-lanceur{right:16px;bottom:16px}
+  .chat{max-height:calc(100vh - 32px)}
+}
+@media (max-width:400px){
+  .apercu-scene{flex-direction:column;align-items:stretch}
+  .miette-accueil{flex-direction:row;flex-basis:auto;align-items:center}

# Copie ce fichier en .env.local et remplis-le. .env.local n'est jamais commité ni servi.
# Sur Vercel : mets les mêmes variables dans Settings > Environment Variables.

# Application LinkedIn (developer.linkedin.com > ton app > Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Droits demandés à la connexion. Par défaut : profil, e-mail et publication
# (produits « Sign In with LinkedIn using OpenID Connect » et « Share on LinkedIn »).
# Quand LinkedIn t'accorde la Community Management API, ajoute :
#   r_member_postAnalytics r_member_profileAnalytics
LINKEDIN_SCOPES=openid profile email w_member_social

# Facultatif : adresse de retour (sinon <site>/api/linkedin/callback), version de l'API REST,
# et clé de chiffrement du cookie (sinon dérivée du secret).
# LINKEDIN_REDIRECT_URI=http://localhost:4174/api/linkedin/callback
# LINKEDIN_API_VERSION=202610
# LINKEDIN_COOKIE_SECRET=
